# ---- LLM (gemini | anthropic | openai) ----
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_MODEL_FAST=gemini-2.5-flash
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ----
APP_URL=http://localhost:3000
ADMIN_TOKEN=change-me            # protège /api/setup et le dashboard (cookie)

# ---- Inngest ----
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
LOOP_CRON=0 6 * * *               # veille quotidienne
CONTENTS_PER_RUN=3

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=                 # groupe de validation
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_IDS=        # ids séparés par des virgules

# ---- Meta ----
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_TOKEN=
META_IG_USER_ID=
META_PUBLISH_ENABLED=false        # passer à true après App Review

# ---- Brand Scout ----
BRAND_SOURCES=https://www.ecf.asso.fr,https://www.ecf.fr,https://www.iwigo.fr
